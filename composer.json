{
    "name": "nimbbl/nimbbl-sdk",
    "description": "Nimbbl PHP client library",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "Sandeep Yadav",
        "email": "sandeep@nimbbl.biz"
    }],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",
        "rmccue/requests": "v1.8.0",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Nimbbl\\Api\\": "src/",
            "Nimbbl\\Tests\\": "tests/"
        },
        "classmap": [
            "src/Order/",
            "src/Payment/",
            "src/Address/",
            "src/PaymentLink/",
            "src/Refund/",
            "src/Transaction/",
            "src/CheckoutUtilities/",
            "src/Auth/",
            "src/Common/",
            "src/API/",
            "src/Log/",
            "src/Webhook/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
